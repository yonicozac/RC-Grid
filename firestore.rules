rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ---- Admins ----
    // Only admins can read; no one can write via client
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Users (profile + following subcollection) ----
    match /users/{uid} {
      // Users can only read/write their own profile
      allow read, write: if isOwner(uid);

      match /following/{trackId} {
        // Users can only read/write their own follows
        allow read, write: if isOwner(uid);
      }
    }

    // ---- Tracks ----
    match /tracks/{trackId} {
      // Any authenticated user can read approved tracks
      allow read: if isAuthenticated() &&
        (resource.data.status == "approved" || isAdmin() || resource.data.createdBy == request.auth.uid);

      // Any authenticated user can create a track (always submitted as pending)
      allow create: if isAuthenticated() &&
        request.resource.data.status == "pending" &&
        request.resource.data.createdBy == request.auth.uid;

      // Only admin can update (approve/reject); track owner cannot self-approve
      allow update: if isAdmin();

      // Admin or track owner can delete
      allow delete: if isAdmin() || resource.data.createdBy == request.auth.uid;
    }

    // ---- Races ----
    match /races/{raceId} {
      // Any authenticated user can read races
      allow read: if isAuthenticated();

      // Only the track owner can create a race for their track
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        get(/databases/$(database)/documents/tracks/$(request.resource.data.trackId)).data.createdBy == request.auth.uid &&
        // timing: "mylaps" (transponder required) or "none"; races without it are MyLaps
        (!("timing" in request.resource.data) || request.resource.data.timing in ["mylaps", "none"]);

      // Only the race creator (track owner) can update, and only the race details:
      // the race can't be moved to another track or handed to another user
      allow update: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "date", "categories"]);

      // Race creator (track owner) or admin can delete
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.createdBy == request.auth.uid);

      // ---- Registrations ----
      match /registrations/{userId} {
        // Any authenticated user can read registrations
        allow read: if isAuthenticated();

        // Users can only write their own registration. Registrations are readable by
        // every signed-in user, so they may hold only these fields (no email);
        // categories/transponder are legacy fields still present on older docs.
        function hasOnlyRegFields() {
          return request.resource.data.keys().hasOnly(
            ["uid", "name", "firstName", "lastName", "nickname", "entries", "registeredAt",
             "categories", "transponder"]);
        }
        allow create: if isOwner(userId) && hasOnlyRegFields() &&
          request.resource.data.uid == userId;
        allow update: if isOwner(userId) && hasOnlyRegFields() &&
          request.resource.data.uid == userId;
        allow delete: if isOwner(userId);

        function isRaceManager() {
          return isAdmin() ||
            (isAuthenticated() &&
              get(/databases/$(database)/documents/races/$(raceId)).data.createdBy == request.auth.uid);
        }

        // Race creator or admin can remove a driver from a category (entries only)...
        allow update: if isRaceManager() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["entries"]);

        // ...or remove the driver entirely (also used when deleting the race)
        allow delete: if isRaceManager();
      }
    }

  }
}
